{
  "quick-actions": {
    "color": {
      "overlay": {
        "$type": "color",
        "$value": "{blanket.default}",
        "$description": "Voile plein écran sous les rangées"
      },
      "row": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{surface.default}",
            "$description": "Fond d'une rangée. Toujours neutre : le ton de l'action ne va que sur la pastille d'icône (IconTile)"
          },
          "hovered": {
            "$type": "color",
            "$value": "{background.neutral.subtlest.hovered}",
            "$description": "Fond d'une rangée survolée"
          },
          "pressed": {
            "$type": "color",
            "$value": "{background.neutral.subtlest.pressed}",
            "$description": "Fond d'une rangée pressée"
          }
        },
        "label": {
          "$type": "color",
          "$value": "{text.default.default}",
          "$description": "Libellé d'une rangée"
        }
      }
    },
    "size": {
      "row": {
        "min-height": {
          "$type": "dimension",
          "$value": "{Size700}",
          "$description": "Hauteur minimale d'une rangée (56 px) : pastille de 40 px et padding vertical de 8 px"
        }
      }
    },
    "spacing": {
      "list": {
        "padding": {
          "$type": "dimension",
          "$value": "{Space200}",
          "$description": "Marge intérieure de la liste, en haut et sur les côtés (16 px)"
        },
        "padding-bottom": {
          "$type": "dimension",
          "$value": "{Space1600}",
          "$description": "Place réservée en bas de la liste au bouton d'action et à la barre (128 px), hors zone de sécurité"
        },
        "gap": {
          "$type": "dimension",
          "$value": "{Space150}",
          "$description": "Écart entre deux rangées (12 px)"
        }
      },
      "row": {
        "gap": {
          "$type": "dimension",
          "$value": "{Space200}",
          "$description": "Écart entre la pastille d'icône et le libellé (16 px)"
        },
        "padding-y": {
          "$type": "dimension",
          "$value": "{Space100}",
          "$description": "Marge intérieure verticale d'une rangée (8 px)"
        },
        "padding-start": {
          "$type": "dimension",
          "$value": "{Space100}",
          "$description": "Marge intérieure côté pastille (8 px), égale au vertical pour centrer la pastille dans l'arrondi"
        },
        "padding-end": {
          "$type": "dimension",
          "$value": "{Space300}",
          "$description": "Marge intérieure côté libellé (24 px)"
        }
      }
    },
    "radius": {
      "row": {
        "$type": "dimension",
        "$value": "{RadiusRound}",
        "$description": "Coins d'une rangée (pilule)"
      }
    },
    "elevation": {
      "row": {
        "$type": "shadow",
        "$value": "{elevation.medium}",
        "$description": "Ombre d'une rangée, qui flotte au-dessus du voile"
      }
    }
  }
}
