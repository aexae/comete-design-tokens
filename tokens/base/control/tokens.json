{
  "Control": {
    "$description": "Dimensions sémantiques partagées des contrôles interactifs (Button, champs) selon la densité : compact (desktop dense), default (desktop standard), touch (mobile / cible tactile).",
    "Height": {
      "Compact": { "$type": "dimension", "$value": "{Size300}", "$description": "Hauteur contrôle — compact (24 px)" },
      "Default": { "$type": "dimension", "$value": "{Size400}", "$description": "Hauteur contrôle — default (32 px)" },
      "Touch":   { "$type": "dimension", "$value": "{Size600}", "$description": "Hauteur contrôle — touch (48 px)" }
    },
    "Radius": {
      "Compact": { "$type": "dimension", "$value": "{Radius050}", "$description": "Radius contrôle — compact (4 px)" },
      "Default": { "$type": "dimension", "$value": "{Radius075}", "$description": "Radius contrôle — default (6 px)" },
      "Touch":   { "$type": "dimension", "$value": "{Radius100}", "$description": "Radius contrôle — touch (8 px)" }
    },
    "PaddingX": {
      "Compact": { "$type": "dimension", "$value": "{Space100}", "$description": "Padding horizontal contrôle — compact (8 px)" },
      "Default": { "$type": "dimension", "$value": "{Space150}", "$description": "Padding horizontal contrôle — default (12 px)" },
      "Touch":   { "$type": "dimension", "$value": "{Space200}", "$description": "Padding horizontal contrôle — touch (16 px)" }
    },
    "Icon": {
      "Compact": { "$type": "dimension", "$value": "{Size250}", "$description": "Taille icône contrôle — compact (20 px)" },
      "Default": { "$type": "dimension", "$value": "{Size300}", "$description": "Taille icône contrôle — default (24 px)" },
      "Touch":   { "$type": "dimension", "$value": "{Size300}", "$description": "Taille icône contrôle — touch (24 px)" }
    }
  }
}
