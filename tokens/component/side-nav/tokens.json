{
  "side-nav": {
    "color": {
      "surface": {
        "background": {
          "$type": "color",
          "$value": "{surface.default}",
          "$description": "Fond du panneau de navigation (aussi le fond au survol d'un item désactivé)"
        },
        "border": {
          "$type": "color",
          "$value": "{border.subtle}",
          "$description": "Bordure droite du panneau, séparation avec le contenu"
        }
      },
      "header": {
        "title": {
          "$type": "color",
          "$value": "{text.default.default}",
          "$description": "Nom de l'application dans l'en-tête"
        },
        "subtitle": {
          "$type": "color",
          "$value": "{text.subtlest.default}",
          "$description": "Sous-titre de l'en-tête (module, client)"
        }
      },
      "item": {
        "background": {
          "hovered": {
            "$type": "color",
            "$value": "{background.neutral.subtlest.hovered}",
            "$description": "Fond d'un item au survol"
          },
          "pressed": {
            "$type": "color",
            "$value": "{background.neutral.subtlest.pressed}",
            "$description": "Fond d'un item à l'appui"
          }
        },
        "text": {
          "$type": "color",
          "$value": "{text.subtle.default}",
          "$description": "Libellé d'un item non sélectionné"
        }
      },
      "item-selected": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{background.selected.subtle.default}",
            "$description": "Fond de l'item de la page courante"
          },
          "hovered": {
            "$type": "color",
            "$value": "{background.selected.subtle.hovered}",
            "$description": "Fond de l'item de la page courante au survol"
          },
          "pressed": {
            "$type": "color",
            "$value": "{background.selected.subtle.pressed}",
            "$description": "Fond de l'item de la page courante à l'appui"
          }
        },
        "text": {
          "$type": "color",
          "$value": "{text.selected}",
          "$description": "Libellé de l'item de la page courante"
        }
      },
      "section-title": {
        "$type": "color",
        "$value": "{text.subtle.default}",
        "$description": "Titre de section (capitales)"
      },
      "divider": {
        "$type": "color",
        "$value": "{border.subtle}",
        "$description": "Séparateur entre groupes d'items"
      },
      "empty": {
        "icon-background": {
          "$type": "color",
          "$value": "{background.neutral.subtlest.default}",
          "$description": "Pastille de l'icône de l'état vide"
        },
        "title": {
          "$type": "color",
          "$value": "{text.default.default}",
          "$description": "Titre de l'état vide"
        },
        "description": {
          "$type": "color",
          "$value": "{text.subtlest.default}",
          "$description": "Description de l'état vide"
        }
      }
    },
    "size": {
      "rail-width": {
        "$type": "dimension",
        "$value": "{Size1000}",
        "$description": "Largeur du panneau en mode rail (80 px)"
      },
      "item": {
        "icon": {
          "$type": "dimension",
          "$value": "{Size300}",
          "$description": "Icône d'item (24 px), fixe aussi la hauteur de ligne : hauteur d'item = icône + 2 × spacing.item.padding-y (36 px)"
        }
      },
      "rail-item": {
        "min-height": {
          "$type": "dimension",
          "$value": "{Size400}",
          "$description": "Hauteur minimale d'un item en rail (32 px)"
        }
      },
      "header": {
        "logo": {
          "$type": "dimension",
          "$value": "{Size500}",
          "$description": "Hauteur maximale du logo de l'en-tête (40 px)"
        },
        "min-height": {
          "$type": "dimension",
          "$value": "72px",
          "$description": "Hauteur minimale de l'en-tête (72 px). Valeur brute : aucun token d'échelle à 72 px"
        }
      },
      "footer-brand": {
        "$type": "dimension",
        "$value": "{Size300}",
        "$description": "Hauteur maximale de la marque du pied (24 px)"
      },
      "empty": {
        "icon": {
          "$type": "dimension",
          "$value": "{Size500}",
          "$description": "Pastille de l'icône de l'état vide (40 px)"
        }
      },
      "width": {
        "$type": "dimension",
        "$value": "240px",
        "$description": "Largeur du panneau déployé (240 px). Valeur brute : aucun token d'échelle à 240 px"
      }
    },
    "spacing": {
      "gutter": {
        "$type": "dimension",
        "$value": "{Space100}",
        "$description": "Gouttière horizontale du panneau (8 px), reprise à droite par la zone défilante"
      },
      "inset": {
        "$type": "dimension",
        "$value": "{Space150}",
        "$description": "Retrait horizontal commun de l'en-tête, des items, titres de section, séparateurs et pied (12 px)"
      },
      "header": {
        "gap": {
          "$type": "dimension",
          "$value": "{Space150}",
          "$description": "Espace entre le logo, le nom et le bouton de bascule (12 px)"
        },
        "padding-top": {
          "$type": "dimension",
          "$value": "{Space300}",
          "$description": "Marge haute de l'en-tête (24 px)"
        },
        "padding-bottom": {
          "$type": "dimension",
          "$value": "{Space100}",
          "$description": "Marge basse de l'en-tête (8 px)"
        }
      },
      "item": {
        "gap": {
          "$type": "dimension",
          "$value": "{Space150}",
          "$description": "Espace entre l'icône et le libellé (12 px)"
        },
        "padding-y": {
          "$type": "dimension",
          "$value": "{Space050}",
          "$description": "Padding vertical d'un item (4 px) : hauteur 32 px avec l'icône de 24 px"
        }
      },
      "rail": {
        "padding-x": {
          "$type": "dimension",
          "$value": "{Space050}",
          "$description": "Retrait horizontal des items et titres de section en rail (4 px)"
        },
        "item-gap": {
          "$type": "dimension",
          "$value": "{Space025}",
          "$description": "Espace entre l'icône et le libellé court en rail (2 px)"
        }
      },
      "section-title": {
        "padding-top": {
          "$type": "dimension",
          "$value": "{Space200}",
          "$description": "Marge au-dessus d'un titre de section (16 px)"
        },
        "padding-bottom": {
          "$type": "dimension",
          "$value": "{Space025}",
          "$description": "Marge sous un titre de section (2 px)"
        }
      },
      "divider": {
        "margin-y": {
          "$type": "dimension",
          "$value": "{Space075}",
          "$description": "Marge verticale du séparateur (6 px)"
        }
      },
      "footer": {
        "padding-y": {
          "$type": "dimension",
          "$value": "{Space200}",
          "$description": "Marge verticale du pied (16 px)"
        }
      },
      "empty": {
        "gap": {
          "$type": "dimension",
          "$value": "{Space150}",
          "$description": "Espace entre l'icône, le texte et l'action de l'état vide (12 px)"
        },
        "padding-y": {
          "$type": "dimension",
          "$value": "{Space400}",
          "$description": "Marge verticale de l'état vide (32 px)"
        },
        "padding-x": {
          "$type": "dimension",
          "$value": "{Space200}",
          "$description": "Marge horizontale de l'état vide (16 px)"
        },
        "text-gap": {
          "$type": "dimension",
          "$value": "{Space050}",
          "$description": "Espace entre le titre et la description de l'état vide (4 px)"
        },
        "action": {
          "$type": "dimension",
          "$value": "{Space100}",
          "$description": "Marge au-dessus de l'action de l'état vide (8 px)"
        }
      },
      "skeleton": {
        "gap": {
          "$type": "dimension",
          "$value": "{Space075}",
          "$description": "Espace entre les lignes d'un placeholder de chargement (6 px)"
        }
      }
    },
    "radius": {
      "item": {
        "$type": "dimension",
        "$value": "{Radius0375}",
        "$description": "Coins d'un item (3 px)"
      },
      "divider": {
        "$type": "dimension",
        "$value": "{Radius0125}",
        "$description": "Coins du séparateur (1 px)"
      },
      "empty-icon": {
        "$type": "dimension",
        "$value": "{RadiusRound}",
        "$description": "Pastille ronde de l'état vide"
      }
    },
    "border-width": {
      "surface": {
        "$type": "dimension",
        "$value": "{Size0125}",
        "$description": "Bordure droite du panneau (1 px)"
      },
      "divider": {
        "$type": "dimension",
        "$value": "{Size025}",
        "$description": "Épaisseur du séparateur (2 px)"
      }
    },
    "opacity": {
      "disabled": {
        "$type": "number",
        "$value": "{opacity.disabled}",
        "$description": "Opacité d'un item désactivé (standard disabled par opacité)"
      },
      "footer-brand": {
        "$type": "number",
        "$value": "{opacity.50}",
        "$description": "Opacité de la marque du pied (0,5)"
      }
    }
  }
}
