{
  "name": "@aexae/comete-design-tokens",
  "version": "0.44.0",
  "author": "Comète",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Comète design tokens — CSS custom properties (primitives + semantic light/dark).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexae/comete-design-tokens.git"
  },
  "sideEffects": false,
  "files": [
    "build/css",
    "build/omnis",
    "tokens"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "pnpm clean && tsx build.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "inventory": "tsx scripts/inventory.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "eslint": "^9.0.0",
    "style-dictionary": "^5.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "rimraf": "^6.1.2"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css": "./build/css/comete-tokens.css",
    "./omnis/*": "./build/omnis/*",
    "./tokens/*": "./tokens/*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
