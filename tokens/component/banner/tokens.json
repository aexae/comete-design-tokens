{
  "banner": {
    "color": {
      "warning": {
        "background": {
          "$type": "color",
          "$value": "{background.warning.bold.default}",
          "$description": "Fond du bandeau warning (jaune)"
        },
        "text": {
          "$type": "color",
          "$value": "{text.on-light-surface}",
          "$description": "Message du bandeau warning (texte sombre fixe, lisible sur le jaune)"
        },
        "icon": {
          "$type": "color",
          "$value": "{icon.on-light-surface}",
          "$description": "Icône contextuelle du bandeau warning"
        }
      },
      "critical": {
        "background": {
          "$type": "color",
          "$value": "{background.critical.bold.default}",
          "$description": "Fond du bandeau critical (rouge)"
        },
        "text": {
          "$type": "color",
          "$value": "{text.on-dark-surface}",
          "$description": "Message du bandeau critical (texte inversé)"
        },
        "icon": {
          "$type": "color",
          "$value": "{icon.on-dark-surface}",
          "$description": "Icône contextuelle du bandeau critical"
        }
      },
      "announcement": {
        "background": {
          "$type": "color",
          "$value": "{background.accent.purple.bold.default}",
          "$description": "Fond du bandeau announcement (violet accent : nouveauté, mise à jour majeure)"
        },
        "text": {
          "$type": "color",
          "$value": "{text.inverted.default}",
          "$description": "Message du bandeau announcement (texte inversé)"
        },
        "icon": {
          "$type": "color",
          "$value": "{icon.inverted}",
          "$description": "Icône contextuelle du bandeau announcement"
        }
      },
      "success": {
        "background": {
          "$type": "color",
          "$value": "{background.success.bold.default}",
          "$description": "Fond du bandeau success (vert)"
        },
        "text": {
          "$type": "color",
          "$value": "{text.inverted.default}",
          "$description": "Message du bandeau success (texte inversé)"
        },
        "icon": {
          "$type": "color",
          "$value": "{icon.inverted}",
          "$description": "Icône contextuelle du bandeau success"
        }
      },
      "information": {
        "background": {
          "$type": "color",
          "$value": "{background.information.bold.default}",
          "$description": "Fond du bandeau information (bleu)"
        },
        "text": {
          "$type": "color",
          "$value": "{text.inverted.default}",
          "$description": "Message du bandeau information (texte inversé)"
        },
        "icon": {
          "$type": "color",
          "$value": "{icon.inverted}",
          "$description": "Icône contextuelle du bandeau information"
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{Space150}",
        "$description": "Espace entre l'icône et le message (12 px)"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{Space150}",
        "$description": "Marge intérieure du bandeau sur les quatre côtés (12 px)"
      }
    },
    "size": {
      "icon": {
        "$type": "dimension",
        "$value": "{Size300}",
        "$description": "Largeur et hauteur de l'icône du bandeau (24 px)"
      }
    }
  }
}
