{
  "quick-actions-menu": {
    "color": {
      "blanket": {
        "$type": "color",
        "$value": "{blanket.default}",
        "$description": "Voile plein écran sous les items"
      }
    },
    "list": {
      "spacing": {
        "padding": {
          "$type": "dimension",
          "$value": "{Space200}",
          "$description": "Marge intérieure de la liste, en haut et sur les côtés (16 px)"
        },
        "padding-bottom": {
          "$type": "dimension",
          "$value": "{Space1600}",
          "$description": "Place réservée en bas de la liste au bouton d'action et à la barre (128 px), hors zone de sécurité"
        },
        "gap": {
          "$type": "dimension",
          "$value": "{Space150}",
          "$description": "Écart entre deux items (12 px)"
        }
      }
    },
    "item": {
      "color": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{surface.default}",
            "$description": "Fond d'un item. Toujours neutre : le ton de l'action ne va que sur la pastille d'icône (IconTile)"
          },
          "hovered": {
            "$type": "color",
            "$value": "{background.neutral.subtlest.hovered}",
            "$description": "Fond d'un item survolée"
          },
          "pressed": {
            "$type": "color",
            "$value": "{background.neutral.subtlest.pressed}",
            "$description": "Fond d'un item pressée"
          }
        },
        "text": {
          "$type": "color",
          "$value": "{text.default.default}",
          "$description": "Libellé d'un item"
        }
      },
      "size": {
        "min-height": {
          "$type": "dimension",
          "$value": "{Size700}",
          "$description": "Hauteur minimale d'un item (56 px) : pastille de 40 px et padding vertical de 8 px"
        }
      },
      "spacing": {
        "gap": {
          "$type": "dimension",
          "$value": "{Space200}",
          "$description": "Écart entre la pastille d'icône et le libellé (16 px)"
        },
        "padding-y": {
          "$type": "dimension",
          "$value": "{Space100}",
          "$description": "Marge intérieure verticale d'un item (8 px)"
        },
        "padding-start": {
          "$type": "dimension",
          "$value": "{Space100}",
          "$description": "Marge intérieure côté pastille (8 px), égale au vertical pour centrer la pastille dans l'arrondi"
        },
        "padding-end": {
          "$type": "dimension",
          "$value": "{Space300}",
          "$description": "Marge intérieure côté libellé (24 px)"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{RadiusRound}",
        "$description": "Coins d'un item (pilule)"
      },
      "elevation": {
        "$type": "shadow",
        "$value": "{elevation.medium}",
        "$description": "Ombre d'un item, qui flotte au-dessus du voile"
      }
    }
  }
}
